echo "🚀 Running pre-push checks..."

# 1. Run ESLint
echo "📝 Checking code with ESLint..."
npm run lint || {
  echo "❌ ESLint failed! Fix errors before pushing."
  exit 1
}

# 2. Run type check
echo "🔍 Type checking TypeScript..."
npm run type-check || {
  echo "❌ TypeScript type check failed! Fix errors before pushing."
  exit 1
}

# 3. Run build
echo "🔨 Building project..."
npm run build || {
  echo "❌ Build failed! Fix compilation errors before pushing."
  exit 1
}

# 4. dist/ commitado = build do src/ commitado (quem instala via git usa o dist/).
#    Só confere com o src/ sem alterações locais: com trabalho em andamento o
#    build reflete o working tree, não o commit.
if [ -z "$(git status --porcelain -- src)" ] && [ -n "$(git status --porcelain -- dist)" ]; then
  echo "❌ O dist/ commitado não corresponde ao src/: o build acabou de atualizá-lo."
  echo "   Commite o dist/ (git add dist && git commit) e faça o push de novo."
  exit 1
fi

echo "✅ All pre-push checks passed!"
